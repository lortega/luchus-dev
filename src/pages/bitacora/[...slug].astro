---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import {
  leerRegistro,
  folio,
  fechaLarga,
  iso,
  minutosDeLectura,
  type Registro,
} from '../../lib/bitacora';

export async function getStaticPaths() {
  const registros = await leerRegistro();
  return registros.map((registro, i) => ({
    params: { slug: registro.entrada.id },
    props: {
      registro,
      masNueva: registros[i - 1] ?? null,
      masAntigua: registros[i + 1] ?? null,
    },
  }));
}

interface Props {
  registro: Registro;
  masNueva: Registro | null;
  masAntigua: Registro | null;
}

const { registro, masNueva, masAntigua } = Astro.props;
const { entrada } = registro;
const { Content } = await render(entrada);
const minutos = minutosDeLectura(entrada.body ?? '');
---

<Base
  titulo={entrada.data.titulo}
  descripcion={entrada.data.resumen}
  tipo="article"
  fecha={entrada.data.fecha}
>
  <div class="envoltura">
    <article class="articulo">
      <header class="articulo__cabecera">
        <div class="articulo__meta mono">
          <span>#{folio(registro.folio)}</span>
          <span class="sep">/</span>
          <time datetime={iso(entrada.data.fecha)}>{fechaLarga(entrada.data.fecha)}</time>
          <span class="sep">/</span>
          <span>{minutos} min</span>
        </div>
        <h1 class="articulo__titulo">{entrada.data.titulo}</h1>
        <p class="articulo__resumen">{entrada.data.resumen}</p>
        {
          entrada.data.tags.length > 0 && (
            <ul class="tags">
              {entrada.data.tags.map((t) => (
                <li>{t}</li>
              ))}
            </ul>
          )
        }
      </header>

      <hr class="articulo__regla" />

      <div class="prosa">
        <Content />
      </div>
    </article>

    {
      (masNueva || masAntigua) && (
        <nav class="vecinas" aria-label="Otras entradas">
          {masAntigua ? (
            <a class="vecina vecina--ant" href={`/bitacora/${masAntigua.entrada.id}/`}>
              <span class="rotulo">← anterior · #{folio(masAntigua.folio)}</span>
              <span class="vecina__titulo">{masAntigua.entrada.data.titulo}</span>
            </a>
          ) : (
            <span class="vecina" aria-hidden="true" />
          )}
          {masNueva ? (
            <a class="vecina vecina--sig" href={`/bitacora/${masNueva.entrada.id}/`}>
              <span class="rotulo">siguiente · #{folio(masNueva.folio)} →</span>
              <span class="vecina__titulo">{masNueva.entrada.data.titulo}</span>
            </a>
          ) : (
            <span class="vecina" aria-hidden="true" />
          )}
        </nav>
      )
    }
  </div>
</Base>
