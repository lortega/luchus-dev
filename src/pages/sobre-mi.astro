---
import Base from '../layouts/Base.astro';
import { SITIO } from '../consts';
---

<Base
  titulo="Sobre mí"
  descripcion={`Quién es ${SITIO.autor} y de qué trata esta bitácora.`}
>
  <div class="envoltura">
    <div class="pagina">
      <h1 class="pagina__titulo">Sobre mí</h1>
      <div class="prosa">
        <p>
          Soy <strong>{SITIO.autor}</strong>, desarrollador de software. Trabajo sobre todo en
          aplicaciones web: modelar el dominio, hacer que funcione en producción y volver a
          mirarlo cuando se rompe.
        </p>
        <p>
          Esta bitácora es el cuaderno donde dejo lo que no cabe en un commit: por qué elegí
          una solución y no otra, qué salió mal después, y qué haría distinto la próxima vez.
          Escribo en español porque casi todo lo que leo sobre esto está en inglés, y algunas
          de estas cosas merecen existir en el idioma en que las pienso.
        </p>
        <h2>Dónde encontrarme</h2>
        <ul>
          <li><a href="https://github.com/lortega" rel="me">GitHub</a></li>
          <li><a href="/rss.xml">RSS de la bitácora</a></li>
        </ul>
      </div>
    </div>
  </div>
</Base>
