---
import Base from '../layouts/Base.astro';
---

<Base title="Página no encontrada" description="Esa dirección no existe en luchus.dev.">
  <div class="envoltura">
    <div class="pagina">
      <p class="rotulo">error 404</p>
      <h1 class="pagina__titulo">Esta nota no está en el registro.</h1>
      <div class="prosa">
        <p>
          La dirección que abriste no existe, o la nota cambió de nombre.
          <a href="/">Volver al registro</a>.
        </p>
      </div>
    </div>
  </div>
</Base>
