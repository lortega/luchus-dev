---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="That address does not exist on luchus.dev.">
  <div class="envoltura">
    <div class="pagina">
      <p class="rotulo">error 404</p>
      <h1 class="pagina__titulo">This note is not in the log.</h1>
      <div class="prosa">
        <p>
          The address you opened does not exist, or the note was renamed.
          <a href="/">Back to the log</a>.
        </p>
      </div>
    </div>
  </div>
</Base>
