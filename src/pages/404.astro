---
import Base from '../layouts/Base.astro';
---

<Base titulo="Página no encontrada" descripcion="Esa dirección no existe en luchus.dev.">
  <div class="envoltura">
    <div class="pagina">
      <p class="rotulo">error 404</p>
      <h1 class="pagina__titulo">Esta entrada no está en el registro.</h1>
      <div class="prosa">
        <p>
          La dirección que abriste no existe, o la entrada cambió de nombre.
          <a href="/">Volver a la bitácora</a>.
        </p>
      </div>
    </div>
  </div>
</Base>
