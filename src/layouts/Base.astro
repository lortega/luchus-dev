---
import BaseHead from '../components/BaseHead.astro';
import Cabecera from '../components/Cabecera.astro';
import Pie from '../components/Pie.astro';

interface Props {
  title: string;
  description: string;
  type?: 'website' | 'article';
  date?: Date;
}
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead {...Astro.props} />
  </head>
  <body>
    <a class="saltar" href="#contenido">Skip to content</a>
    <Cabecera />
    <main id="contenido">
      <slot />
    </main>
    <Pie />
  </body>
</html>
