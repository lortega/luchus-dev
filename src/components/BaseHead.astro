---
import { Font } from 'astro:assets';
import { SITIO } from '../consts';
import '../styles/global.css';

interface Props {
  titulo: string;
  descripcion: string;
  tipo?: 'website' | 'article';
  fecha?: Date;
}

const { titulo, descripcion, tipo = 'website', fecha } = Astro.props;
const canonica = new URL(Astro.url.pathname, Astro.site);
const tituloCompleto = titulo === SITIO.titulo ? titulo : `${titulo} · ${SITIO.titulo}`;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{tituloCompleto}</title>
<meta name="description" content={descripcion} />
<meta name="author" content={SITIO.autor} />
<link rel="canonical" href={canonica} />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={`Bitácora de ${SITIO.autor}`}
  href={new URL('rss.xml', Astro.site)}
/>

<meta property="og:type" content={tipo} />
<meta property="og:title" content={tituloCompleto} />
<meta property="og:description" content={descripcion} />
<meta property="og:url" content={canonica} />
<meta property="og:locale" content="es_CL" />
<meta property="og:site_name" content={SITIO.titulo} />
{fecha && <meta property="article:published_time" content={fecha.toISOString()} />}
<meta name="twitter:card" content="summary" />

<Font cssVariable="--font-display" preload />
<Font cssVariable="--font-body" preload />
<Font cssVariable="--font-mono" />
