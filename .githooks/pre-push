#!/usr/bin/env bash
# Corre `astro check` antes de cada push.
#
# En este repo se commitea directo a master y cada push despliega el sitio, así
# que no hay revisión intermedia. Y `astro build` no hace typecheck: un error de
# tipos o una plantilla rota compila igual y se publica. Este hook es el filtro.
#
# Se activa con:  git config core.hooksPath .githooks
# Saltarlo a propósito:  git push --no-verify

set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

if [ ! -d node_modules ]; then
  echo "pre-push: falta node_modules, se omite astro check. Corré 'npm install'." >&2
  exit 0
fi

echo "pre-push: astro check…"
if ! npm run --silent check; then
  echo "" >&2
  echo "pre-push: astro check falló. Push cancelado para no desplegar esto." >&2
  exit 1
fi
